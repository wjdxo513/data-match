# DataMatch 환경별 접속 정보 예시
#
# 이 파일을 같은 폴더에 datamatch.properties 로 복사한 뒤 값을 채운다.
# datamatch.properties 는 비밀번호를 담으므로 Git과 배포 zip에 포함하지 않는다(기술 설계서 TD-06).
# 모든 환경은 읽기 전용 계정을 사용한다(PRD NFR-03).
# 사용하지 않는 환경은 항목 전체를 지우면 화면의 환경 목록에서 빠진다.

# 개발
datamatch.environments.dev.url=jdbc:oracle:thin:@//<host>:<port>/<service>
datamatch.environments.dev.username=<읽기 전용 계정>
datamatch.environments.dev.password=<비밀번호>

# 테스트
datamatch.environments.test.url=jdbc:oracle:thin:@//<host>:<port>/<service>
datamatch.environments.test.username=<읽기 전용 계정>
datamatch.environments.test.password=<비밀번호>

# 운영
datamatch.environments.prod.url=jdbc:oracle:thin:@//<host>:<port>/<service>
datamatch.environments.prod.username=<읽기 전용 계정>
datamatch.environments.prod.password=<비밀번호>

# 포트를 바꿀 때만 사용한다(기본 18080).
# server.port=18080
