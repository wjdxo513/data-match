{
  "description": "거래번호 짝 입력 파서 공유 테스트 케이스(실행 계획 BE-02, FE-01). 백엔드 PairsParser와 프론트 pairsParser.ts가 같은 결과를 내야 한다.",
  "format": {
    "name": "케이스 이름",
    "numericPk": "true면 PK가 NUMBER라서 숫자 형식을 검사한다",
    "input": "입력창 원문. repeat가 있으면 무시한다",
    "repeat": "{count, template}: template의 {n}을 1..count로 바꾼 줄을 \\n으로 이어 입력으로 쓴다",
    "expected.pairs": "[줄 번호, 거래번호A, 거래번호B] 목록(생략하면 검사하지 않음)",
    "expected.errors": "[줄 번호, 오류 코드] 목록. 줄 번호는 원문 기준 1부터",
    "expected.pairCount": "유효한 짝 수",
    "expected.limitExceeded": "유효한 짝이 maxPairs를 넘으면 true(PAIR_LIMIT_EXCEEDED)"
  },
  "rules": [
    "구분자는 쉼표 또는 탭이며 한 줄에 정확히 하나여야 한다",
    "값의 앞뒤 공백을 제거한다",
    "공백만 있는 줄은 무시하되 줄 번호는 원문 기준으로 센다",
    "한 줄에는 대표 오류 하나만 보고한다: 구분자 없음 > 구분자 2개 이상 > A 비어 있음 > B 비어 있음 > 숫자 형식",
    "숫자 형식은 부호와 소수점을 허용하고 지수 표기는 허용하지 않는다",
    "오류는 첫 오류에서 멈추지 않고 모두 수집한다"
  ],
  "maxPairs": 1000,
  "cases": [
    { "name": "쉼표 구분", "numericPk": false, "input": "A1,B1\nA2,B2",
      "expected": { "pairs": [[1, "A1", "B1"], [2, "A2", "B2"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "탭 구분(엑셀 두 열 붙여넣기)", "numericPk": false, "input": "A1\tB1\nA2\tB2",
      "expected": { "pairs": [[1, "A1", "B1"], [2, "A2", "B2"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "앞뒤 공백 제거", "numericPk": false, "input": "  A1 ,  B1  \n A2\t B2 ",
      "expected": { "pairs": [[1, "A1", "B1"], [2, "A2", "B2"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "빈 줄과 공백 줄 무시, 원문 줄 번호 유지", "numericPk": false, "input": "A1,B1\n\n   \n\t\nA2,B2\n",
      "expected": { "pairs": [[1, "A1", "B1"], [5, "A2", "B2"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "CRLF 줄바꿈", "numericPk": false, "input": "A1,B1\r\nA2,B2\r\n",
      "expected": { "pairs": [[1, "A1", "B1"], [2, "A2", "B2"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "같은 짝 중복 허용", "numericPk": false, "input": "A1,B1\nA1,B1",
      "expected": { "pairs": [[1, "A1", "B1"], [2, "A1", "B1"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "구분자 없음", "numericPk": false, "input": "A1 B1",
      "expected": { "pairs": [], "errors": [[1, "NO_DELIMITER"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "거래번호A 비어 있음", "numericPk": false, "input": ",B1\n  ,B2",
      "expected": { "pairs": [], "errors": [[1, "EMPTY_A"], [2, "EMPTY_A"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "거래번호B 비어 있음", "numericPk": false, "input": "A1,\nA2\t\nA3,   ",
      "expected": { "pairs": [], "errors": [[1, "EMPTY_B"], [2, "EMPTY_B"], [3, "EMPTY_B"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "양쪽 모두 비어 있으면 EMPTY_A", "numericPk": false, "input": " , ",
      "expected": { "pairs": [], "errors": [[1, "EMPTY_A"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "구분자 2개 이상", "numericPk": false, "input": "A1,B1,C1\nA2,B2\tC2\n,,",
      "expected": { "pairs": [], "errors": [[1, "TOO_MANY_DELIMITERS"], [2, "TOO_MANY_DELIMITERS"], [3, "TOO_MANY_DELIMITERS"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "여러 오류를 한 번에 수집", "numericPk": false, "input": "A1,B1\nbad\n,B3\nA4,\nA5,B5,C5\nA6,B6",
      "expected": { "pairs": [[1, "A1", "B1"], [6, "A6", "B6"]], "errors": [[2, "NO_DELIMITER"], [3, "EMPTY_A"], [4, "EMPTY_B"], [5, "TOO_MANY_DELIMITERS"]], "pairCount": 2, "limitExceeded": false } },
    { "name": "빈 입력", "numericPk": false, "input": "",
      "expected": { "pairs": [], "errors": [], "pairCount": 0, "limitExceeded": false } },
    { "name": "공백 줄만 있는 입력", "numericPk": false, "input": "\n   \n\t\n",
      "expected": { "pairs": [], "errors": [], "pairCount": 0, "limitExceeded": false } },
    { "name": "문자 PK에서는 숫자 검사 안 함", "numericPk": false, "input": "ABC,DEF\n1e5,X",
      "expected": { "pairs": [[1, "ABC", "DEF"], [2, "1e5", "X"]], "errors": [], "pairCount": 2, "limitExceeded": false } },
    { "name": "숫자 PK 정상", "numericPk": true, "input": "1,100001\n 2 , 100002\n-3,4.5",
      "expected": { "pairs": [[1, "1", "100001"], [2, "2", "100002"], [3, "-3", "4.5"]], "errors": [], "pairCount": 3, "limitExceeded": false } },
    { "name": "숫자 PK에 숫자가 아닌 값", "numericPk": true, "input": "1,ABC\nX1,2\n1e5,3\n4,5",
      "expected": { "pairs": [[4, "4", "5"]], "errors": [[1, "INVALID_NUMBER"], [2, "INVALID_NUMBER"], [3, "INVALID_NUMBER"]], "pairCount": 1, "limitExceeded": false } },
    { "name": "숫자 PK에서도 빈 값은 EMPTY 오류가 우선", "numericPk": true, "input": ",1\n2,",
      "expected": { "pairs": [], "errors": [[1, "EMPTY_A"], [2, "EMPTY_B"]], "pairCount": 0, "limitExceeded": false } },
    { "name": "경계값 1쌍", "numericPk": false, "input": "A1,B1",
      "expected": { "pairs": [[1, "A1", "B1"]], "errors": [], "pairCount": 1, "limitExceeded": false } },
    { "name": "경계값 1,000쌍", "numericPk": false, "repeat": { "count": 1000, "template": "A{n},B{n}" },
      "expected": { "errors": [], "pairCount": 1000, "limitExceeded": false } },
    { "name": "경계값 1,001쌍 초과", "numericPk": false, "repeat": { "count": 1001, "template": "A{n},B{n}" },
      "expected": { "errors": [], "pairCount": 1001, "limitExceeded": true } }
  ]
}
